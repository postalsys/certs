{
    "clean": true,
    "all": true,
    "temp-directory": "./coverage/.tmp",
    "reporter": ["text", "html"],
    "include": ["src/**/*.ts"],
    "exclude": ["src/package-info.ts", "src/**/types.ts", "src/**/*.d.ts"],
    "exclude-after-remap": true,
    "check-coverage": true,
    "lines": 95,
    "statements": 95,
    "branches": 90,
    "functions": 95
}
