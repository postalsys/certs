{
    "name": "@postalsys/certs",
    "version": "2.0.0",
    "description": "Manage Let's Encrypt certificates",
    "type": "module",
    "main": "./dist/cjs/certs.js",
    "types": "./dist/cjs/certs.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/certs.js",
            "require": "./dist/cjs/certs.js"
        },
        "./lib/*.js": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./lib/*": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "SECURITY.md",
        "SECURITY.txt"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "node scripts/build.js --generate-only && tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test --test-force-exit $(find test -name \"*-test.ts\")",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test --test-force-exit $(find test -name \"*-test.ts\")",
        "pretest:cjs": "npm run build",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module node test/package/cjs-smoke.cjs",
        "pretest:pkg": "npm run build",
        "test:pkg": "node scripts/pkg-smoke.js",
        "test:mutation": "node scripts/mutation-test.js",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "keywords": [],
    "author": {
        "name": "Postal Systems OÜ",
        "email": "acme@postalsys.com"
    },
    "license": "ISC",
    "homepage": "https://github.com/postalsys/certs#readme",
    "bugs": {
        "url": "https://github.com/postalsys/certs/issues"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/certs.git"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "express": "4.22.3",
        "globals": "17.13.0",
        "ioredis": "6.0.0",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    },
    "dependencies": {
        "@msgpack/msgpack": "3.1.3",
        "ioredfour": "2.0.0",
        "joi": "18.3.0",
        "pino": "10.3.1",
        "punycode.js": "2.3.1",
        "undici": "7.30.1"
    }
}
